{
  "id": "runner_lower_body",
  "label": "Runner-pack rifle-8way locomotion (Mixamo skeleton)",
  "rigId": "mixamo",
  "_note": "Runner-pack equivalent of gasp_lower_body.json. Uses rifle-8way slugs (mixamorig:* skeleton, runner_glb conversion). Selector logic in src/anim/locomotion.js (selectGaspLocomotion) is shared — same state IDs (walk_F, run_FL, sprint_F, crouch_idle, etc.), only the clip names differ. Hipfire `clip` plays the low-ready stance; `adsClip` is the aimed shoulder pose for the same direction (currently shared across directions because the rifle-8way pack only ships one aiming-idle variant; per-direction ADS is a polish pass).",

  "thresholds": {
    "moving":    0.2,
    "walkMax":   1.6,
    "runMax":    3.5,
    "sprintMax": 6.0,
    "crouched":  "from playerState"
  },

  "states": {
    "stand_idle":    { "clip": "rifle-8way/idle",            "adsClip": "rifle-8way/idle-aiming",            "oneHandClip": "pistol-locomotion/pistol-idle", "loop": true },
    "crouch_idle":   { "clip": "rifle-8way/idle-crouching",  "adsClip": "rifle-8way/idle-crouching-aiming",  "oneHandClip": "pistol-locomotion/pistol-idle", "loop": true },

    "walk_F":  { "clip": "rifle-8way/walk-forward",        "loop": true, "speedRef": 1.4 },
    "walk_B":  { "clip": "rifle-8way/walk-backward",       "loop": true, "speedRef": 1.2 },
    "walk_FL": { "clip": "rifle-8way/walk-forward-right",  "loop": true, "speedRef": 1.3 },
    "walk_FR": { "clip": "rifle-8way/walk-forward-left",   "loop": true, "speedRef": 1.3 },
    "walk_BL": { "clip": "rifle-8way/walk-backward-right", "loop": true, "speedRef": 1.2 },
    "walk_BR": { "clip": "rifle-8way/walk-backward-left",  "loop": true, "speedRef": 1.2 },

    "run_F":   { "clip": "rifle-8way/run-forward",         "loop": true, "speedRef": 4.0 },
    "run_B":   { "clip": "rifle-8way/run-backward",        "loop": true, "speedRef": 2.5 },
    "run_FL":  { "clip": "rifle-8way/run-forward-right",   "loop": true, "speedRef": 2.7 },
    "run_FR":  { "clip": "rifle-8way/run-forward-left",    "loop": true, "speedRef": 2.7 },
    "run_BL":  { "clip": "rifle-8way/run-backward-right",  "loop": true, "speedRef": 2.5 },
    "run_BR":  { "clip": "rifle-8way/run-backward-left",   "loop": true, "speedRef": 2.5 },

    "sprint_F": { "clip": "rifle-8way/sprint-forward",     "loop": true, "speedRef": 6.0 },

    "_lrFlipNote": "FL/FR/BL/BR clip refs are intentionally flipped (FL → -right, FR → -left). The selector returns body-relative sectors (FL = body's left), but Mixamo authors directional clips with the character moving toward their own left/right which renders mirror-flipped relative to body-local in this rig's coordinate convention. Same flip pattern as gasp_lower_body.json.",

    "crouch_F":  { "clip": "rifle-8way/walk-crouching-forward",        "loop": true, "speedRef": 1.0 },
    "crouch_B":  { "clip": "rifle-8way/walk-crouching-backward",       "loop": true, "speedRef": 0.8 },
    "crouch_FL": { "clip": "rifle-8way/walk-crouching-forward-right",  "loop": true, "speedRef": 0.9 },
    "crouch_FR": { "clip": "rifle-8way/walk-crouching-forward-left",   "loop": true, "speedRef": 0.9 },
    "crouch_BL": { "clip": "rifle-8way/walk-crouching-backward-right", "loop": true, "speedRef": 0.8 },
    "crouch_BR": { "clip": "rifle-8way/walk-crouching-backward-left",  "loop": true, "speedRef": 0.8 }
  },

  "playback": {
    "fadeMs": 200,
    "timeScaleClamp": [0.5, 1.5]
  }
}
