# Dependencies / build output (none today, but guard so a future
# npm / wrangler local install doesn't accidentally commit lockfiles
# or caches).
node_modules/
.wrangler/
.cache/
dist/
build/

# Local editor / tool state
.vscode/
.idea/
# Skills are shared tooling — track them so every machine + teammate
# gets /new-relic and /new-encounter etc. Personal settings stay
# ignored via the more specific rules below.
!.claude/
!.claude/skills/
!.claude/skills/**
.claude/settings.local.json
.claude/settings.json
.claude/agents/
.claude/commands/

# OS noise
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Env / secret files
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# Local test / scratch files
scratch/
tmp/

# Source-archive zips — the original asset-pack downloads (~3 GiB).
# The extracted FBX/PNG files in subfolders are what the game loads
# at runtime, those stay tracked.
Assets/*.zip
Assets/*.unitypackage

# Animation source archives + extracted dirs. Cold Exit ships GLBs
# converted via tools/blender-fbx-to-glb.py; the source FBX/zip can
# be re-acquired from upstream packs and don't need version control.
Assets/models/animations/*.zip
Assets/models/animations/gaspfix_extracted/
Assets/models/animations/FBX_Pistol_Starter_27A/
Assets/models/animations/Universal Animation Library*/

# Chrome DevTools performance traces — accumulating reference snapshots
# in the repo bloats clones. Keep one canonical trace if needed; toss
# the rest.
profiling/*.json
profiling/*.json.gz
tools/__pycache__/

# Large source FBX files — runtime is GLB-only. Idle.fbx (110 MB)
# was stripped from history 2026-05-04 because it exceeded GitHub's
# 100 MB limit. Keep local copies if needed for re-export but don't
# track them. Specific files listed (not blanket *.fbx) so the
# already-tracked W1_* and Man_New_Idle FBXes stay tracked.
Assets/models/Idle.fbx

# Artpass working dir — backups of original silhouettes restored from
# git HEAD for img2img alpha-compose. Not source of truth, just a
# scratch area while regenerating the inventory art pass.
Assets/_artpass_originals/
